APP_NAME=Financial Advisory RAG Platform
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

GROQ_BASE_URL=
GROQ_API_KEY=

OPENAI_BASE_URL=
OPENAI_API_KEY=

CHAT_MODEL=
EMBED_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=50

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=500
LLM_TOP_P=1.0
LLM_STOP_SEQUENCES=

# Vector Database Settings
VECTOR_DB_TYPE=chroma
VECTOR_COLLECTION_NAME=rag_chunks
VECTOR_DIMENSION=1536
VECTOR_DISTANCE_METRIC=cosine
VECTOR_DB_PATH=./data/vector_db
CHROMA_TENANT=
CHROMA_DATABASE=
DATABASE_API_KEY=

# Re-ranking Retrieval Settings
RERANK_ENABLED=true
RERANK_CANDIDATE_K=10
RERANK_FINAL_K=3
RERANK_MODEL=
RERANK_TIMEOUT_SECONDS=5.0

# Context Injection & Token Budget Settings
MAX_MODEL_CONTEXT_TOKENS=8192
MAX_CONTEXT_TOKENS=5000
RESERVED_ANSWER_TOKENS=1500
RESERVED_INSTRUCTION_TOKENS=800

# Retrieval Guardrails & Safe Refusal Settings
MIN_TOP_SCORE=0.72
MIN_SUPPORTING_CHUNKS=1
RETRIEVAL_TOP_K=4
SAFE_REFUSAL_MESSAGE=I don't have enough reliable evidence in the approved knowledge base to answer that question.

# Conversational RAG & Query Rewriting Settings
MAX_CONVERSATION_TURNS=5
MAX_HISTORY_TOKENS=1000
QUERY_REWRITE_MODEL=

# Document Upload & Dynamic Indexing Settings
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=10485760

LOG_LEVEL=INFO


